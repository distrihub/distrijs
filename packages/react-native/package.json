{
  "name": "@distri/react-native",
  "version": "0.1.0",
  "description": "React Native hooks and chat UI for Distri Framework",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": ["dist", "README.md"],
  "dependencies": {
    "@distri/core": "workspace:*",
    "@distri/state": "workspace:*",
    "zustand": "^5.0.7"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.2.10",
    "jsdom": "^29.0.1",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.1"
  },
  "publishConfig": {"access": "public"}
}
